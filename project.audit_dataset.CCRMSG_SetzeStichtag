CREATE OR REPLACE PROCEDURE `project.audit_dataset.CCRMSG_SetzeStichtag`(
  IN v_EintragsNr INT64,
  IN v_Stichtag STRING,
  IN v_Format STRING
)
BEGIN
  DECLARE v_dt DATETIME;

  IF v_EintragsNr IS NULL THEN
    RAISE USING MESSAGE = 'Eintragsnummer nicht gesetzt';
  END IF;
  IF v_Stichtag IS NULL THEN
    RAISE USING MESSAGE = 'Stichtag nicht gesetzt';
  END IF;
  IF v_Format IS NULL THEN
    RAISE USING MESSAGE = 'Format fuer den Stichtag nicht gesetzt';
  END IF;

  SET v_dt = PARSE_DATETIME(v_Format, v_Stichtag);

  UPDATE `project.audit_dataset.message_table`
  SET 
    stichtag = v_dt,
    updated_at = CURRENT_TIMESTAMP()
  WHERE entry_nr = v_EintragsNr;
END;