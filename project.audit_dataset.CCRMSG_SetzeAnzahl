CREATE OR REPLACE PROCEDURE `project.audit_dataset.CCRMSG_SetzeAnzahl`(
  IN v_EintragsNr INT64,
  IN v_Anzahl INT64
)
BEGIN
  IF v_EintragsNr IS NULL THEN
    RAISE USING MESSAGE = 'Eintragsnummer nicht gesetzt';
  END IF;
  IF v_Anzahl IS NULL THEN
    RAISE USING MESSAGE = 'Anzahl Datensätze nicht gesetzt';
  END IF;

  UPDATE `project.audit_dataset.message_table`
  SET 
    anzahl = v_Anzahl,
    updated_at = CURRENT_TIMESTAMP()
  WHERE entry_nr = v_EintragsNr;
END;