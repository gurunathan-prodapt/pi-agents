CREATE OR REPLACE PROCEDURE `project.audit_dataset.CCRMSG_LogDebug`(
  IN v_EintragsNr INT64,
  IN v_Text STRING
)
BEGIN
  IF v_EintragsNr IS NULL THEN
    RAISE USING MESSAGE = 'Eintragsnummer nicht gesetzt';
  END IF;
  IF v_Text IS NULL THEN
    RAISE USING MESSAGE = 'Text nicht gesetzt';
  END IF;

  INSERT INTO `project.audit_dataset.message_log` (entry_nr, severity, log_text, created_at)
  VALUES (v_EintragsNr, 'DEBUG', v_Text, CURRENT_TIMESTAMP());
END;

