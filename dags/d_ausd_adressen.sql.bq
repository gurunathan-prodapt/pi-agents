-- Step03: Create temporary tables for reachability, country, country_description, and laender_kng
INSERT INTO `{{ params.target_dataset }}.sof_ta_country`
(  COUNTRY_CODE, DESCRIPTION_ID, PARENT_COUNTRY_CODE, EU_INDICATOR, SAP_CODE, CORR_CODE, VALID)
SELECT
      country.COUNTRY_CODE,
      country.DESCRIPTION_ID,
      country.PARENT_COUNTRY_CODE,
      country.EU_INDICATOR,
      country.SAP_CODE,
      country.CORR_CODE,
      country.VALID
FROM    `{{ params.source_dataset }}.glv_ta_country` country
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_country_desc`
(   DESCRIPTION_ID, LANGUAGE, SHORT_DESCRIPTION, DESCRIPTION, LONG_DESCRIPTION)
SELECT
           des.DESCRIPTION_ID,
           des.LANGUAGE,
           des.SHORT_DESCRIPTION,
         des.DESCRIPTION,
           des.LONG_DESCRIPTION
FROM    `{{ params.source_dataset }}.glv_ta_description` des
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_laender_kng`
(COUNTRY_CODE, DESCRIPTION_ID, LANGUAGE, SHORT_DESCRIPTION, DESCRIPTION, LONG_DESCRIPTION)
SELECT  co.country_code,
        de.DESCRIPTION_ID,
              de.LANGUAGE,
              de.SHORT_DESCRIPTION,
              de.DESCRIPTION,
              de.LONG_DESCRIPTION
FROM    `{{ params.target_dataset }}.sof_ta_country`         co
JOIN    `{{ params.target_dataset }}.sof_ta_country_desc`    de
ON   co.description_id = de.description_id
WHERE   co.valid = 1
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_reachability`
(  BP_ID, REACHABILITY_ID, OBJ_VERSION, COUNTRY_CODE, FOR_THE_ATTENTION_OF,
  ADDRESS_ATTACHMENT, ADDRESS_ATTACHMENT_ORG, CORP_UNIT, SURNAME_S, FIRST_NAME_G,
  ZIP_CODE, CITY, POBOX, STREET, HOUSE_NR, PUBLIC_AREA_A, PRIVATE_AREA_P,
  CORP_UNIT_OU1, ADDRESS_LINE_1, ADDRESS_LINE_2, REACHABLE_FROM, REACHABLE_THRU)
SELECT
        re.bp_id,
        re.reachability_id,
        re.obj_version,
        re.country_code,
        re.for_the_attention_of,
        re.address_attachment,
        re.address_attachment_org,
        re.corp_unit,
        re.surname_s,
        re.first_name_g,
        re.zip_code,
        re.city,
        re.pobox,
        re.street,
        re.house_nr,
        re.public_area_a,
        re.private_area_p,
        re.corp_unit_ou1,
        re.address_line_1,
        re.address_line_2,
        re.reachable_from,
        re.reachable_thru
FROM    `{{ params.source_dataset }}.bpd_ta_reachability` re
WHERE   (re.insert_at <= v_stichtag
         AND (   re.modified_at IS NULL
              OR re.modified_at > v_stichtag))
  AND   (re.valid_from <= v_stichtag
         AND (   re.valid_to IS NULL
              OR re.valid_to > v_stichtag))
  AND   re.is_production = 1
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_e_reach_gp`
(  BP_ID, REACHABILITY_ID, OBJ_VERSION, COUNTRY_CODE, FOR_THE_ATTENTION_OF,
  ADDRESS_ATTACHMENT, ADDRESS_ATTACHMENT_ORG, CORP_UNIT, SURNAME_S, FIRST_NAME_G,
  ZIP_CODE, CITY, POBOX, STREET, HOUSE_NR, PUBLIC_AREA_A, PRIVATE_AREA_P,
  CORP_UNIT_OU1, ADDRESS_LINE_1, ADDRESS_LINE_2, REACHABLE_FROM, REACHABLE_THRU,
  CNTRCT_CP2_ID, INV_DEF_INVREC_ID, BPR_INST_EVNREC_ID, BPR_INST_SRVUSR_ID, LAND_SD)
SELECT
        re.BP_ID,
        re.REACHABILITY_ID,
        re.OBJ_VERSION,
        re.COUNTRY_CODE,
        re.FOR_THE_ATTENTION_OF,
        re.ADDRESS_ATTACHMENT,
        re.ADDRESS_ATTACHMENT_ORG,
        re.CORP_UNIT,
        re.SURNAME_S,
        re.FIRST_NAME_G,
        re.ZIP_CODE,
        re.CITY,
        re.POBOX,
        re.STREET,
        re.HOUSE_NR,
        re.PUBLIC_AREA_A,
        re.PRIVATE_AREA_P,
        re.CORP_UNIT_OU1,
        re.ADDRESS_LINE_1,
        re.ADDRESS_LINE_2,
        re.REACHABLE_FROM,
        re.REACHABLE_THRU,
        br.cntrct_cp2_id,
        br.inv_def_invrec_id,
        br.bpr_inst_evnrec_id,
        br.bpr_inst_srvusr_id,
        SUBSTR(lk.short_description, 1, 3) AS land_sd
FROM    `{{ params.target_dataset }}.sof_ta_bp_ref_gp`       br
JOIN    `{{ params.target_dataset }}.sof_ta_reachability`    re
  ON   br.bp_id = re.bp_id
  AND   br.reachability_id = re.reachability_id
LEFT JOIN `{{ params.target_dataset }}.sof_ta_laender_kng`     lk
  ON   re.country_code    = lk.country_code
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_e_reach_re`
(  BP_ID, REACHABILITY_ID, OBJ_VERSION, COUNTRY_CODE, FOR_THE_ATTENTION_OF,
  ADDRESS_ATTACHMENT, ADDRESS_ATTACHMENT_ORG, CORP_UNIT, SURNAME_S, FIRST_NAME_G,
