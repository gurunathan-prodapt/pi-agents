FROM    `{{ params.target_dataset }}.sof_ta_bp_ref_re`       br
JOIN    `{{ params.target_dataset }}.sof_ta_reachability`    re
  ON   br.bp_id           = re.bp_id
  AND   br.reachability_id = re.reachability_id
LEFT JOIN `{{ params.target_dataset }}.sof_ta_laender_kng`     lk
