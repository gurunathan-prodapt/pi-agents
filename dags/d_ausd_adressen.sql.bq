-- Step04: Create business partner tables
INSERT INTO `{{ params.target_dataset }}.sof_ta_business_pt`
(BP_ID, ORGANISATION_NAME, TITLE, SURNAME, FIRST_NAME, SALES_TAX_FREED, TM_CUSTOMERID)
SELECT
        bp.bp_id,
        bp.organisation_name,
        bp.title,
        bp.surname,
        bp.first_name,
        bp.sales_tax_freed,
        bp.tm_customerid
FROM    `{{ params.source_dataset }}.bpd_ta_business_partner` bp
WHERE   (bp.insert_at <= v_stichtag
         AND (   bp.modified_at IS NULL
              OR bp.modified_at > v_stichtag))
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_bp_ref_gp_nodp`
(BP_ID)
SELECT DISTINCT bp_id
FROM    `{{ params.target_dataset }}.sof_ta_bp_ref_gp` ref_gp
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_e_business_gp`
(BP_ID, ORGANISATION_NAME, TITLE, SURNAME, FIRST_NAME, SALES_TAX_FREED, TM_CUSTOMERID )
SELECT
        bp.bp_id,
        bp.organisation_name,
        bp.title,
        bp.surname,
        bp.first_name,
        bp.sales_tax_freed,
        bp.tm_customerid
FROM    `{{ params.target_dataset }}.sof_ta_bp_ref_gp_nodp`  br
JOIN    `{{ params.target_dataset }}.sof_ta_business_pt`     bp
  ON   br.bp_id = bp.bp_id
;

