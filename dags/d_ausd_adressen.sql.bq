-- Legacy Source: vobs/dw_source/isrpt/isbert/SQL/aktuell/aufbereitung/sql/d_ausd_adressen.sql
-- Job: vobs/dw_source/isrpt/isbert/SQL/aktuell/aufbereitung/bin/k_ausd_adressen.ksh
-- Converted to BigQuery Standard SQL

-- Parameter for the effective date (stichtag)
-- This variable will be set by the Airflow DAG based on p_Stichtag.
DECLARE v_stichtag_str STRING DEFAULT '{{ dag_run.conf.p_stichtag if dag_run.conf else params.p_stichtag }}';
DECLARE v_stichtag DATE DEFAULT PARSE_DATE('%Y%m%d', v_stichtag_str);

-- Step01: Clear target tables if they exist and are persistent.
-- The original Oracle script truncates these tables, implying they are not temporary.
-- Assuming 'sof_ta_' tables starting with 'e_' are final output tables,
-- and others (like sof_ta_country) are intermediate persistent tables.

TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_gp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_re`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_ev`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_dn`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_gp_nodp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_re_nodp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_ev_nodp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_bp_ref_dn_nodp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_reachability`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_business_pt`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_country`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_country_desc`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_laender_kng`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_reach_gp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_reach_re`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_reach_dn`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_reach_ev`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_business_gp`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_business_re`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_business_dn`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_business_ev`;
TRUNCATE TABLE `{{ params.target_dataset }}.sof_ta_e_regulierer`;

-- Step00: Variable definition (v_datum handled by DECLARE above).
-- The original `v_carmen` variable was used for a database link or schema prefix.
-- In BigQuery, this is typically handled by fully qualified table names in the form `project.dataset.table`.
-- For source tables, we'll use `params.source_dataset`.

-- Step02: Create temporary tables for bp_ref
INSERT INTO `{{ params.target_dataset }}.sof_ta_bp_ref_gp`
( BP_ID, REACHABILITY_ID, CNTRCT_CP2_ID, INV_DEF_INVREC_ID, BPR_INST_EVNREC_ID, BPR_INST_SRVUSR_ID)
SELECT
        bpr.bp_id,
        bpr.reachability_id,
        bpr.cntrct_cp2_id,
        bpr.inv_def_invrec_id,
        bpr.bpr_inst_evnrec_id,
        bpr.bpr_inst_srvusr_id
FROM    `{{ params.source_dataset }}.cds_ta_bp_ref` bpr
WHERE   (bpr.insert_at <= v_stichtag
         AND (   bpr.modified_at IS NULL
             OR bpr.modified_at > v_stichtag))
  AND   (bpr.valid_from <= v_stichtag
         AND (   bpr.valid_to IS NULL
              OR bpr.valid_to > v_stichtag))
  AND   bpr.is_production  = 1
  AND   bpr.bp_ref_ty      = 4
  AND   bpr.address_ref_ty = 6
;

INSERT INTO `{{ params.target_dataset }}.sof_ta_bp_ref_re`
(BP_ID, REACHABILITY_ID, CNTRCT_CP2_ID, INV_DEF_INVREC_ID, BPR_INST_EVNREC_ID, BPR_INST_SRVUSR_ID)
SELECT
        bpr.bp_id,
        bpr.reachability_id,
        bpr.cntrct_cp2_id,
        bpr.inv_def_invrec_id,
        bpr.bpr_inst_evnrec_id,
        bpr.bpr_inst_srvusr_id
FROM    `{{ params.source_dataset }}.cds_ta_bp_ref` bpr
WHERE   (bpr.insert_at <= v_stichtag
         AND (   bpr.modified_at IS NULL
              OR bpr.modified_at > v_stichtag))
  AND   (bpr.valid_from <= v_stichtag
         AND (   bpr.valid_to IS NULL
              OR bpr.valid_to > v_stichtag))
  AND   bpr.is_production  = 1
  AND   bpr.bp_ref_ty = 1
  AND   bpr.address_ref_ty = 5          --rechnungsempfaenger
UNION ALL
SELECT
        id.rdndnt_cp2_bp_id AS bp_id,
        id.rdndnt_cp2_reachability_id AS reachability_id,
        NULL AS cntrct_cp2_id,
        id.inv_definition_id AS inv_def_invrec_id,
        NULL AS bpr_inst_evnrec_id,
        NULL AS bpr_inst_srvusr_id
FROM    `{{ params.source_dataset }}.cds_ta_inv_definition` id
WHERE   (id.insert_at <= v_stichtag
         AND (   id.modified_at IS NULL
              OR id.modified_at > v_stichtag))
  AND   (id.valid_from <= v_stichtag
         AND (   id.valid_to IS NULL
              OR id.valid_to > v_stichtag))
  AND   id.is_production  = 1
  AND   id.rdndant_invrec = 0;

